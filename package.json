{
  "name": "dys",
  "version": "2.1.0",
  "description": "Numarataj Şube Müdürlüğü Dosya Yönetim Sistemi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "author": "BURAK TONOZ",
  "dependencies": {
    "@tesseract.js-data/tur": "^1.0.0",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "^5.1.1"
  },
  "build": {
    "appId": "com.tonoz.dys",
    "productName": "DYS",
    "copyright": "Copyright © 2026 - TONOZ",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "!node_modules/pdfjs-dist/{legacy,web,types,image_decoders}/**",
      "!node_modules/**/*.map"
    ],
    "win": {
      "target": "portable",
      "executableName": "DYS",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "DYS.exe"
    },
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "~30.5.1",
    "electron-builder": "^24.13.3"
  }
}
